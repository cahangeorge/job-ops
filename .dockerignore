# Dependencies
**/node_modules
**/.venv
**/__pycache__

# Build outputs
**/dist
**/*.pyc

# Data (mounted as volume)
data/

# Orchestrator runtime/debug storage (may contain browser session cookies)
orchestrator/storage/

# Local agent planning and research material
.hermes/plans/
.hermes/research/

# Local linked worktrees
.worktrees/

# Environment files (passed via docker-compose)
.env
**/.env
**/.env.local

# Git
.git
.gitignore

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test files
**/*.test.ts
**/*.spec.ts
**/test/
**/tests/
**/__tests__/

# Documentation
*.md
!README.md
!docs-site/**/*.md
!docs-site/**/*.mdx

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Docker
Dockerfile*
docker-compose*

# Temporary files
tmp
temp
*.tmp

# Coverage
coverage
