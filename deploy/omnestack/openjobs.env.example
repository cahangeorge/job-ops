# JobOps production environment for Dokploy/Omnestack.
# Copy these values into Dokploy and replace placeholders there.
# Do not commit real secrets.

###############################################################################
# Required
###############################################################################

NODE_ENV=production
PORT=3001
DATA_DIR=/app/data
CODEX_HOME=/app/codex-home
PYTHON_PATH=/usr/bin/python3
JOBOPS_PUBLIC_BASE_URL=https://openjobs.omnestack.com

# Use at least 32 random characters. Keep stable across redeploys.
JWT_SECRET=replace-with-at-least-32-random-characters

###############################################################################
# Required for AI features unless configured through onboarding/UI
###############################################################################

# Common values: openrouter, openai, glm, gemini, openai-compatible.
LLM_PROVIDER=openrouter
MODEL=replace-with-model-name
LLM_API_KEY=replace-with-llm-api-key

# Required for openai-compatible providers such as a hosted Ollama/LM Studio proxy.
# LLM_BASE_URL=https://llm-provider.example.com/v1

###############################################################################
# Optional webhooks and public links
###############################################################################

# Bearer token for POST /api/webhook/trigger.
# WEBHOOK_SECRET=replace-with-webhook-secret

# Called when a pipeline run completes. WEBHOOK_URL is a legacy fallback.
# PIPELINE_WEBHOOK_URL=https://automation.example.com/jobops/pipeline
# WEBHOOK_URL=https://automation.example.com/jobops/pipeline

# Called when a job completes selected actions.
# JOB_COMPLETE_WEBHOOK_URL=https://automation.example.com/jobops/job-complete

###############################################################################
# Optional auth and session tuning
###############################################################################

# BASIC_AUTH_USER=replace-with-username
# BASIC_AUTH_PASSWORD=replace-with-password
# JWT_EXPIRY_SECONDS=604800

###############################################################################
# Optional integrations
###############################################################################

# Reactive Resume import/export support.
# RXRESUME_URL=https://rxresu.me
# RXRESUME_API_KEY=replace-with-rxresume-api-key

# Gmail post-application tracking.
# GMAIL_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
# GMAIL_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
# GMAIL_OAUTH_REDIRECT_URI=https://openjobs.omnestack.com/oauth/gmail/callback

# Adzuna extractor.
# ADZUNA_APP_ID=replace-with-adzuna-app-id
# ADZUNA_APP_KEY=replace-with-adzuna-app-key

# Seek extractor via Apify.
# APIFY_TOKEN=replace-with-apify-token

# UK Visa Jobs extractor.
# UKVISAJOBS_EMAIL=replace-with-login-email
# UKVISAJOBS_PASSWORD=replace-with-login-password

###############################################################################
# Optional runtime tuning
###############################################################################

# LOG_LEVEL=info
# DEMO_MODE=false
# PIPELINE_TOP_N=10
# PIPELINE_MIN_SCORE=50

# Jobspy defaults.
# JOBSPY_SEARCH_TERMS=web developer
# SEARCH_CITIES=London|Manchester|Remote
# JOBSPY_COUNTRY_INDEED=uk
# JOBSPY_RESULTS_WANTED=200
# JOBSPY_HOURS_OLD=72

# Extractor-specific limits.
# ADZUNA_MAX_JOBS_PER_TERM=50
# STARTUPJOBS_MAX_RESULTS=50
# SEEK_MAX_JOBS_PER_TERM=50
# NAUKRI_MAX_JOBS_PER_TERM=50
# JOBINDEX_MAX_JOBS_PER_TERM=50

# Challenge viewer defaults from the Docker image are usually correct.
# JOBOPS_CHALLENGE_VIEWER=enabled
# NOVNC_HOST=127.0.0.1
# NOVNC_PORT=6080
# VNC_HOST=127.0.0.1
# VNC_PORT=5900
